<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PublishDir>./FortniteEmotesNDances/plugins/FortniteEmotesNDances</PublishDir>
    <OutputPath>$(PublishDir)</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <CustomSourceDir>./gamedata</CustomSourceDir>
    <!-- CSS loads GameData from addons/counterstrikesharp/gamedata/, not from the plugin folder -->
    <CustomTargetDir>$(PublishDir)../../../gamedata</CustomTargetDir>
  </PropertyGroup>

  <ItemGroup>
    <CustomSourceFiles Include="$(CustomSourceDir)\**\*.*" />
    <None Update="gamedata\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyCustomDirectory" AfterTargets="Build;Publish">
    <MakeDir Directories="$(CustomTargetDir)" />
    <Copy SourceFiles="@(CustomSourceFiles)" DestinationFolder="$(CustomTargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.375">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />

    <ProjectReference Include="..\API\FortniteEmotesNDancesAPI.csproj">
      <Private>false</Private>
    </ProjectReference>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Полный EmoteDances — класть в addons/counterstrikesharp/configs/plugins/FortniteEmotesNDances/ -->
    <None Update="configs\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginConfig" AfterTargets="Build;Publish">
    <PropertyGroup>
      <CssConfigsDir>$(PublishDir)../../../configs/plugins/FortniteEmotesNDances</CssConfigsDir>
    </PropertyGroup>
    <MakeDir Directories="$(CssConfigsDir)" />
    <Copy SourceFiles="configs\FortniteEmotesNDances.json"
          DestinationFolder="$(CssConfigsDir)"
          SkipUnchangedFiles="false"
          Condition="Exists('configs\FortniteEmotesNDances.json')" />
  </Target>

</Project>
